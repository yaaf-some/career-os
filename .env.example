# HTTP bind address inside container / local dev
CAREER_OS_BIND=127.0.0.1:8080

# SQLite database URL (WAL mode enabled at startup)
DATABASE_URL=sqlite:///data/career-os.db?mode=rwc

# Host-side AI bridge (macOS launchd service)
AI_BRIDGE_URL=http://host.docker.internal:8787
# Shared secret, same value as the bridge plist (openssl rand -hex 32, >= 32 chars).
# Leave empty until the bridge is set up.
AI_BRIDGE_TOKEN=
# Optional daily agy call budget shown in the Usage Bar (blank = no limit)
AI_AGY_DAILY_CALL_LIMIT=

# Internal scanner container URL
SCANNER_URL=http://scanner:8081

# 32-byte base64 key used to encrypt stored OAuth tokens (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=base64-32-bytes

# Google OAuth credentials (Testing mode: 7-day weekly re-sign-in, Gmail/Drive/Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Google Maps + Places API (LA commute distance & duration for non-remote roles)
GOOGLE_MAPS_API_KEY=
# Neighborhood/city only (never commit a street address)
HOME_LOCATION_AREA=West Los Angeles, CA
DEFAULT_TRAVEL_MODE=DRIVE

# Optional Linear API key for issue synchronization
LINEAR_API_KEY=

# Tailscale identity allowed through Tailscale Serve headers
ALLOWED_TAILSCALE_USER=you@example.com
